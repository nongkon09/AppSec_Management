# --- App ---
APP_ENV=local
SECRET_KEY=change-me-in-real-deployment-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Comma-separated browser origins allowed to call the API (the dashboard hostname).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg://appsec:appsec@localhost:5432/appsec

# --- Dependency-Track integration (FR-2.5 / FR-2.7) ---
DEPENDENCY_TRACK_BASE_URL=http://localhost:8081
# Read-only key (VIEW_PORTFOLIO, VIEW_VULNERABILITY) used for pull-sync.
DEPENDENCY_TRACK_API_KEY=change-me-read-only-service-account-key
# Optional write key (BOM_UPLOAD, PROJECT_CREATION_UPLOAD) used only to forward manual/COTS SBOMs.
DEPENDENCY_TRACK_UPLOAD_API_KEY=
# Exploitation signals fetched during sync (defaults are the public feeds; empty disables).
# CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
# EPSS_API_URL=https://api.first.org/data/v1/epss
# OSV_API_URL=https://api.osv.dev/v1/vulns

# --- Stale detection (FR-2.4) ---
STALE_SBOM_DAYS=90

# --- Background jobs (FR-3.1) ---
# ENABLE_SCHEDULER runs the jobs inside the API process — single-worker setups only.
# Production leaves it off and runs `python -m app.worker` as its own container.
ENABLE_SCHEDULER=false
SBOM_SYNC_INTERVAL_HOURS=6
STALE_CHECK_INTERVAL_HOURS=24
# How often risk exceptions are expired, closed or flagged for review.
EXCEPTION_SWEEP_INTERVAL_HOURS=24

# --- Pentest report uploads (FR-6.5.4) ---
# Local disk directory for uploaded PDF/DOCX reports; mount a persistent volume here
# in production (see deploy/production/docker-compose.yml).
PENTEST_REPORT_UPLOAD_DIR=uploads/pentest-reports
# SBOM files kept as scan evidence for audit (content-addressed by SHA-256).
SBOM_EVIDENCE_DIR=uploads/sbom-evidence

# --- First-run bootstrap (python -m app.bootstrap, run by the production entrypoint) ---
# Only read while the users table is empty; creates this one System Admin.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_EMAIL=admin@example.org
# INITIAL_ADMIN_PASSWORD=
