# AppSec Management Platform + Dependency-Track: production settings.
# scripts/install.sh creates `.env` from this file and fills every <generate> value
# with a random secret. Keep `.env` readable by root only (chmod 600) and back it up
# somewhere safe: losing SECRET_KEY logs everyone out, losing the DB passwords locks
# you out of your own data.

# --- Public addresses (what users' browsers and CI/CD use) ---
# Where users open the platform. Must match exactly, including scheme and port.
APP_PUBLIC_URL=http://appsec.example.org
# Dependency-Track UI and API as reached from a browser / CI runner.
DTRACK_UI_PUBLIC_URL=http://appsec.example.org:8082
DTRACK_API_PUBLIC_URL=http://appsec.example.org:8081

# --- Published ports (host side) ---
APP_PORT=80
DTRACK_UI_PORT=8082
DTRACK_API_PORT=8081
# Set to 127.0.0.1 when a reverse proxy on the same host terminates TLS in front.
APP_BIND=0.0.0.0
DTRACK_BIND=0.0.0.0

# --- Secrets ---
POSTGRES_PASSWORD=<generate>
DTRACK_DB_PASSWORD=<generate>
SECRET_KEY=<generate>

# --- First-run administrator (used only while the users table is empty) ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_PASSWORD=<generate>

# --- Dependency-Track keys: written by scripts/dtrack-bootstrap.py ---
# DTRACK_ADMIN_PASSWORD=
# DEPENDENCY_TRACK_API_KEY=
# DEPENDENCY_TRACK_UPLOAD_API_KEY=

# --- Versions and sizing ---
APP_VERSION=0.3.0
DTRACK_VERSION=4.14.4
DTRACK_MEMORY_LIMIT=6g
# Push/pull images under your own registry name, e.g. registry.example.org/appsec
IMAGE_PREFIX=appsec-platform

# --- Behaviour ---
ACCESS_TOKEN_EXPIRE_MINUTES=480
STALE_SBOM_DAYS=90
SBOM_SYNC_INTERVAL_HOURS=6
STALE_CHECK_INTERVAL_HOURS=24
EXCEPTION_SWEEP_INTERVAL_HOURS=24

# --- Outbound internet (KEV/EPSS/OSV lookups, Dependency-Track feeds) ---
# HTTPS_PROXY=http://proxy.example.org:3128
# HTTP_PROXY=http://proxy.example.org:3128
# NO_PROXY=.example.org
# Air-gapped: set these to empty to switch the lookups off.
# CISA_KEV_FEED_URL=
# EPSS_API_URL=
# OSV_API_URL=
